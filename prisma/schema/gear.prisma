model GearItem {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String   @db.Text
  brand       String   @db.VarChar(255)
  pricePerDay Float
  stock       Int
  imageUrl    String?  @db.Text
  categoryId  String
  category    Category @relation("CategoryGear", fields: [categoryId], references: [id], onDelete: Cascade)
  providerId  String
  provider    User     @relation("ProviderGear", fields: [providerId], references: [id], onDelete: Cascade)

  rentals RentalOrder[] @relation("GearRentals")
  reviews Review[]      @relation("GearReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gear_items")
}
