model User {
    id            String       @id @default(uuid())
    name          String       @db.VarChar(255)
    email         String       @unique @db.VarChar(255)
    password      String       @db.VarChar(255)
    active_status ActiveStatus @default(Active)
    role          Role         @default(Customer)
    created_at    DateTime     @default(now())
    updated_at    DateTime     @updatedAt

    profile_image String?       @db.Text
    bio           String?       @db.Text
    gearItems     GearItem[]    @relation("ProviderGear")
    rentals       RentalOrder[] @relation("CustomerRentals")
    reviews       Review[]      @relation("CustomerReviews")

    @@map("users")
}

enum ActiveStatus {
    Active
    Inactive
}

enum Role {
    Admin
    Customer
    Provider
}
