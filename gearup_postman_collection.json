    {
      "name": "Gear Catalog",
      "item": [
        {
          "name": "Browse Gear with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gear?category=Cycling&availableOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["gear"],
              "query": [
                {
                  "key": "category",
                  "value": "Cycling"
                },
                {
                  "key": "availableOnly",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get Gear Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gear/:id",
              "host": ["{{baseUrl}}"],
              "path": ["gear", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "gear-item-uuid-here"
                }
              ]
            }
          }
        },
