### Server Health Check
GET http://localhost:5000/

### Variables
@baseUrl = http://localhost:5000/api

### 1. Register Customer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Jane Customer",
  "email": "jane.customer@example.com",
  "password": "customer123",
  "role": "Customer",
  "profile_image": "https://example.com/avatar.jpg"
}

### 2. Register Provider
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "John Provider",
  "email": "john.provider@example.com",
  "password": "provider123",
  "role": "Provider",
  "profile_image": "https://example.com/avatar.jpg"
}

### 3. Login Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123"
}

### 4. Login Customer
# @name loginCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "user123"
}

### 5. Login Provider
# @name loginProvider
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john.provider@example.com",
  "password": "provider123"
}

### 6. Refresh Token
# (Note: Express cookie-parser will read the refreshToken cookie automatically)
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json

### 7. Get My Profile (Customer)
# Uses the loginCustomer response variable automatically
@customerToken = {{loginCustomer.response.body.data.accessToken}}

GET {{baseUrl}}/auth/me
Authorization: Bearer {{customerToken}}

### 8. Update My Profile (Customer)
PUT {{baseUrl}}/auth/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "name": "Jane Updated",
  "bio": "Avid cyclist and hiker"
}

### 9. Admin: Get All Users (Admin only)
# Uses the loginAdmin response variable automatically
@adminToken = {{loginAdmin.response.body.data.accessToken}}

GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}

### 10. Admin: Update User Status (Suspend Provider)
# Set target user's UUID from the list returned in GET /admin/users
@userIdToSuspend = 9da32f54-85c0-4b94-9a75-87a8d228bcfb

PATCH {{baseUrl}}/admin/users/{{userIdToSuspend}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "active_status": "Active"
}

### 11. Categories (Public & Admin)
GET {{baseUrl}}/categories

### Create Category (Admin Only)
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Climbing Gear",
  "description": "Harnesses, ropes, and carabiners."
}

### 12. Gear (Public & Provider & Admin)
GET {{baseUrl}}/gear?availableOnly=true

### Create Gear Listing (Provider Only)
@providerToken = {{loginProvider.response.body.data.accessToken}}

POST {{baseUrl}}/provider/gear
Authorization: Bearer {{providerToken}}
Content-Type: application/json

{
  "name": "Standard Climbing Harness",
  "description": "Adjustable leg loops and comfort padding.",
  "brand": "Black Diamond",
  "pricePerDay": 8.0,
  "stock": 5,
  "imageUrl": "https://example.com/harness.jpg",
  "categoryId": "f3673767-759e-4f35-a3d0-de320b834db7"
}

### 13. Create Rental Order (Customer Only)
POST {{baseUrl}}/rentals
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "gearItemId": "894b3517-d091-418d-b55a-a978729e94bb",
  "startDate": "2026-07-15T12:00:00Z",
  "endDate": "2026-07-20T12:00:00Z"
}

### 14. Create Payment Intent (Customer Only)
# Use your created Rental Order ID from the response above
@rentalOrderId = c42c474d-1aac-4c5c-a6a3-a660b6074cce

POST {{baseUrl}}/payments/create
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "rentalOrderId": "{{rentalOrderId}}"
}

### 15. Confirm Payment (Customer Only)
# Use your generated Stripe transaction ID (e.g. pi_...)
@transactionId = pi_3TrhFSQK4g5kgamz1Uv04U0c

POST {{baseUrl}}/payments/confirm
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "transactionId": "{{transactionId}}"
}

### 16. Update Rental Status (Provider Only)
# Update order to returned
PATCH {{baseUrl}}/provider/orders/{{rentalOrderId}}
Authorization: Bearer {{providerToken}}
Content-Type: application/json

{
  "status": "RETURNED"
}

### 17. Submit Review (Customer Only)
POST {{baseUrl}}/reviews
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "gearItemId": "894b3517-d091-418d-b55a-a978729e94bb",
  "rating": 5,
  "comment": "Perfect condition, highly recommended!"
}

